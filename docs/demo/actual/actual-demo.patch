diff --git a/packages/sync-server/src/app-simplefin/integration.test.ts b/packages/sync-server/src/app-simplefin/integration.test.ts
new file mode 100644
index 00000000..dbcd27c1
--- /dev/null
+++ b/packages/sync-server/src/app-simplefin/integration.test.ts
@@ -0,0 +1,110 @@
+import { once } from 'node:events';
+import { createServer } from 'node:http';
+import type { IncomingHttpHeaders, Server } from 'node:http';
+
+import request from 'supertest';
+
+import type * as LoadConfig from '#load-config';
+import { SecretName, secretsService } from '#services/secrets-service';
+
+import { handlers } from './app-simplefin';
+
+// Nothing is mocked except the config: SimpleFIN talks to a real local HTTP
+// server through the real undici fetch and SSRF dispatcher.
+const allowedNetworks = vi.hoisted(() => [] as string[]);
+vi.mock('#load-config', async importOriginal => {
+  const original = await importOriginal<typeof LoadConfig>();
+  const get = original.config.get.bind(original.config);
+  vi.spyOn(original.config, 'get').mockImplementation(name =>
+    name === 'simplefinAllowedNetworks' ? allowedNetworks : get(name),
+  );
+  return original;
+});
+
+type Hit = { method?: string; url?: string; headers: IncomingHttpHeaders };
+
+let server: Server;
+let origin: string;
+let hits: Hit[];
+
+beforeAll(async () => {
+  allowedNetworks.push('127.0.0.0/8');
+  server = createServer((req, res) => {
+    hits.push({ method: req.method, url: req.url, headers: req.headers });
+    if (req.method === 'POST' && req.url === '/claim/abc') {
+      res.end(`${origin.replace('://', '://user:pass@')}/simplefin`);
+    } else if (req.url?.startsWith('/simplefin/moved/accounts')) {
+      res.writeHead(302, { Location: '/simplefin/accounts?balances-only=1' });
+      res.end();
+    } else if (req.url?.startsWith('/simplefin/accounts')) {
+      res.end(JSON.stringify({ accounts: [{ id: 'acc-1' }], errors: [] }));
+    } else {
+      res.writeHead(404).end();
+    }
+  });
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const address = server.address();
+  if (!address || typeof address === 'string') {
+    throw new Error('Missing test port');
+  }
+  origin = `http://127.0.0.1:${address.port}`;
+});
+
+afterAll(async () => {
+  // Drop any connection a stalled request left open so close() can't hang.
+  server.closeAllConnections();
+  server.close();
+  await once(server, 'close');
+});
+
+beforeEach(() => {
+  hits = [];
+  secretsService.reset(SecretName.simplefin_token);
+  secretsService.reset(SecretName.simplefin_accessKey);
+});
+
+afterEach(() => {
+  secretsService.reset(SecretName.simplefin_token);
+  secretsService.reset(SecretName.simplefin_accessKey);
+});
+
+const basicAuth = `Basic ${Buffer.from('user:pass').toString('base64')}`;
+
+it('claims a setup token and lists accounts over real HTTP', async () => {
+  secretsService.set(
+    SecretName.simplefin_token,
+    Buffer.from(`${origin}/claim/abc`).toString('base64'),
+  );
+
+  const response = await request(handlers)
+    .post('/accounts')
+    .set('x-actual-token', 'valid-token')
+    .expect(200);
+
+  expect(response.body.data.accounts).toEqual([{ id: 'acc-1' }]);
+  expect(secretsService.get(SecretName.simplefin_accessKey)).toBe(
+    `http://user:pass@127.0.0.1:${new URL(origin).port}/simplefin`,
+  );
+  expect(hits.map(({ method, url }) => `${method} ${url}`)).toEqual([
+    'POST /claim/abc',
+    'GET /simplefin/accounts?balances-only=1',
+  ]);
+  expect(hits[1].headers.authorization).toBe(basicAuth);
+});
+
+it('follows a same-origin redirect and keeps the credentials', async () => {
+  secretsService.set(
+    SecretName.simplefin_accessKey,
+    `http://user:pass@127.0.0.1:${new URL(origin).port}/simplefin/moved`,
+  );
+
+  const response = await request(handlers)
+    .post('/accounts')
+    .set('x-actual-token', 'valid-token')
+    .expect(200);
+
+  expect(response.body.data.accounts).toEqual([{ id: 'acc-1' }]);
+  expect(hits).toHaveLength(2);
+  expect(hits[1].headers.authorization).toBe(basicAuth);
+});
