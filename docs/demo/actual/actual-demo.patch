@@ -0,0 +1,74 @@
+import { renderHook } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { useFormat } from './useFormat';
+import { useSyncedPref } from './useSyncedPref';
+
+vi.mock('./useSyncedPref', () => ({
+  useSyncedPref: vi.fn(),
+}));
+
+function mockPrefs(prefs: Record<string, string>) {
+  vi.mocked(useSyncedPref).mockImplementation(
+    (key: string) => [prefs[key], vi.fn()] as never,
+  );
+}
+
+function setup(prefs: Record<string, string>) {
+  mockPrefs({ numberFormat: 'comma-dot', ...prefs });
+  return renderHook(() => useFormat()).result.current;
+}
+
+// Amounts are stored x100 for every currency; the currency's decimal places
+// only change how they are displayed.
+describe('useFormat', () => {
+  beforeEach(() => {
+    vi.mocked(useSyncedPref).mockReset();
+  });
+
+  describe('JPY (no decimal places)', () => {
+    const jpy = { defaultCurrencyCode: 'JPY', hideFraction: 'true' };
+
+    it('stores a typed 1500 as 150000', () => {
+      expect(setup(jpy).fromEdit('1500')).toBe(150000);
+    });
+
