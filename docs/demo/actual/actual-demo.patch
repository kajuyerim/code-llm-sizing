-  status=0
-  err=$(printf '%s' "$input" | "$ROOT/scripts/agent-hooks/$guard" 2>&1) || status=$?
-  case "$status" in
-    0) ;;
-    2) deny "$err" ;;
-    *) deny "$guard failed (exit $status): $err" ;;
-  esac
-done
-allow
