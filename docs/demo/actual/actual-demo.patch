new file mode 100644
index 00000000..fcdcd840
--- /dev/null
+++ b/packages/desktop-client/src/components/util/AmountInput.test.tsx
@@ -0,0 +1,52 @@
+import { render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { useSyncedPref } from '#hooks/useSyncedPref';
+
+import { AmountInput } from './AmountInput';
+
+vi.mock('#hooks/useSyncedPref', () => ({
+  useSyncedPref: vi.fn(),
+}));
+
+function mockPrefs(prefs: Record<string, string>) {
+  vi.mocked(useSyncedPref).mockImplementation(
+    (key: string) => [prefs[key], vi.fn()] as never,
+  );
+}
+
+// Types digits and blurs, returning what the field showed after typing and
+// the stored amount that was reported on blur.
+async function typeDigits(digits: string) {
+  const onUpdate = vi.fn();
+  render(<AmountInput value={0} sign="+" autoDecimals onUpdate={onUpdate} />);
+  const input = screen.getByRole('textbox');
+  await userEvent.clear(input);
+  await userEvent.type(input, digits);
+  const shown = (input as HTMLInputElement).value;
+  await userEvent.tab();
+  return { shown, onUpdate };
+}
+
+describe('AmountInput autoDecimals', () => {
+  beforeEach(() => {
+    vi.mocked(useSyncedPref).mockReset();
+  });
+
+  it('shifts typed digits into decimals for dollars', async () => {
+    mockPrefs({ numberFormat: 'comma-dot', defaultCurrencyCode: 'USD' });
+    const { shown, onUpdate } = await typeDigits('1500');
+
+    expect(shown).toBe('15.00');
+    expect(onUpdate).toHaveBeenLastCalledWith(1500);
+  });
+
+  it('treats typed digits as whole units for yen and stores x100', async () => {
+    mockPrefs({ numberFormat: 'comma-dot', defaultCurrencyCode: 'JPY' });
+    const { shown, onUpdate } = await typeDigits('1500');
+
+    expect(shown).toBe('1500');
+    expect(onUpdate).toHaveBeenLastCalledWith(150000);
+  });
+});
