+    });
+
+    it('round-trips through edit and parse', () => {
+      const format = setup(jpy);
+      expect(format.fromEdit(format.forEdit(150000))).toBe(150000);
+    });
+
+    it('also holds when the fraction is not hidden', () => {
+      const format = setup({ defaultCurrencyCode: 'JPY' });
+      expect(format.fromEdit('1500')).toBe(150000);
+      expect(format.forEdit(150000)).toBe('1,500');
+    });
+  });
+
+  describe('USD (two decimal places)', () => {
+    const usd = { defaultCurrencyCode: 'USD' };
+
+    it('stores a typed 15.00 as 1500', () => {
+      expect(setup(usd).fromEdit('15.00')).toBe(1500);
+    });
+
+    it('displays the stored 1500 as 15.00', () => {
+      const format = setup(usd);
+      expect(format(1500, 'financial')).toContain('15.00');
+      expect(format.forEdit(1500)).toBe('15.00');
+    });
+  });
+
+  it('uses the same stored scale for JPY and USD', () => {
+    expect(setup({ defaultCurrencyCode: 'JPY' }).fromEdit('15')).toBe(
+      setup({ defaultCurrencyCode: 'USD' }).fromEdit('15'),
+    );
+  });
+});
