+import { send } from '@actual-app/core/platform/client/connection';
+import type {
+  CategoryEntity,
+  CategoryGroupEntity,
+} from '@actual-app/core/types/models';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { fetchSpreadsheetQueryData } from './fetchSpreadsheetQueryData';
+import { recalculate } from './recalculate';
+
+vi.mock('@actual-app/core/platform/client/connection', () => ({
+  send: vi.fn(),
+}));
+
+vi.mock('#queries/aqlQuery', () => ({
+  aqlQuery: vi.fn(),
+}));
+
+const categories = [
+  { id: 'cat-rent', name: 'Rent', group: 'group-bills' },
+] as CategoryEntity[];
+const categoryGroups = [
+  { id: 'group-bills', name: 'Bills' },
+] as CategoryGroupEntity[];
+
+// What each month's sheet reports as budgeted for the category.
+const budgeted: Record<string, number> = {
+  '2026-07': 100,
+  '2026-08': 200,
+  '2026-09': 300,
+  '2026-10': 400,
+};
+
+describe('fetchSpreadsheetQueryData with a quarterly Budgeted report', () => {
+  beforeEach(() => {
+    vi.mocked(send).mockImplementation((async (
+      _name: string,
+      { month }: { month: string },
+    ) => [
+      { name: `budget-${categories[0].id}`, value: budgeted[month] },
+    ]) as unknown as typeof send);
+  });
+
+  const fetch = (startDate: string, endDate: string) =>
+    fetchSpreadsheetQueryData({
+      balanceTypeOp: 'totalBudgeted',
+      startDate,
+      endDate,
+      interval: 'Quarterly',
+      categories,
+      categoryGroups,
+      conditions: [],
+      conditionsOp: 'and',
+      conditionsOpKey: '$and',
+      filters: [],
+    });
+
+  it('keys three months of budget rows to the first month of the quarter', async () => {
+    const { assets } = await fetch('2026-07-01', '2026-09-30');
+
+    expect(assets.map(row => row.date)).toEqual([
+      '2026-07',
+      '2026-07',
+      '2026-07',
+    ]);
+  });
+
+  it('sums the months into the quarter total', async () => {
+    const { assets, debts } = await fetch('2026-07-01', '2026-09-30');
+
+    const result = recalculate({
+      item: { id: 'cat-rent', name: 'Rent', hidden: false },
+      intervals: ['2026-07'],
+      assets,
+      debts,
+      groupByLabel: 'category',
+      startDate: '2026-07-01',
+      endDate: '2026-09-30',
+    });
+
+    expect(result.intervalData).toHaveLength(1);
+    expect(result.intervalData[0].totalBudgeted).toBe(100 + 200 + 300);
+  });
+
+  it('keeps a quarter that is only partly in range to the months in range', async () => {
+    const { assets, debts } = await fetch('2026-09-01', '2026-10-31');
+
+    const result = recalculate({
+      item: { id: 'cat-rent', name: 'Rent', hidden: false },
+      intervals: ['2026-07', '2026-10'],
+      assets,
+      debts,
+      groupByLabel: 'category',
+      startDate: '2026-09-01',
+      endDate: '2026-10-31',
+    });
+
+    expect(result.intervalData.map(i => i.totalBudgeted)).toEqual([300, 400]);
+  });
+});
